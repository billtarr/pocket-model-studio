<?xml version="1.0" encoding="utf-8"?>
<!-- 底板从纯色改为极轻的竖向渐变：深青到更深青，让前景的米白口袋在
     状态栏、启动器各种壁纸下都不会「浮」起来。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF00806D"
        android:endColor="#FF00544A"
        android:type="linear" />
</shape>
