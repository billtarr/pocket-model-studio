<!-- 口袋 + 斜插的芯片。口袋是「随身」最省笔墨的符号，芯片是模型本身：
     卡片下半截被袋身挡住，只露出上面一截 —— 装得下，也随时能取出来用。
     几何与 branding/mark.svg 完全一致（卡片绕 (54,38) 逆时针 10°）。
     最外沿距图标中心 ~30，落在自适应图标 66dp 安全区（圆心 54,54、半径 33）内。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="38"
        android:rotation="-10">
        <path
            android:fillColor="#FFFFB300"
            android:pathData="M46,26 h16 a3,3 0 0 1 3,3 v18 a3,3 0 0 1 -3,3 h-16 a3,3 0 0 1 -3,-3 v-18 a3,3 0 0 1 3,-3 z" />
    </group>

    <!-- 口袋：宽底、两侧微收，袋口是一道横线 -->
    <path
        android:fillColor="#FFEFF6F3"
        android:pathData="M34,44 H74 L73,74 Q72.5,82 64,82 H44 Q35.5,82 35,74 Z" />
</vector>
